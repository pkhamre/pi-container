#!/usr/bin/env bash
set -euo pipefail
umask 077

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="${PI_CONTAINER_REPO:-$(cd "$SCRIPT_DIR/.." && pwd)}"
ENGINE="${CONTAINER_ENGINE:-}"

if [[ -z "$ENGINE" ]]; then
  if command -v podman >/dev/null 2>&1; then ENGINE=podman
  elif command -v docker >/dev/null 2>&1; then ENGINE=docker
  else echo "Error: no container engine found; install Podman/Docker or set CONTAINER_ENGINE" >&2; exit 1; fi
fi
command -v "$ENGINE" >/dev/null 2>&1 || { echo "Error: container engine not found: $ENGINE" >&2; exit 1; }

STATE_DIR="${HOME}/.pi-container"
WORKSPACE="${PI_WORKSPACE:-$(pwd)}"
MEMORY_LIMIT="${MEMORY_LIMIT:-4g}"
CPU_LIMIT="${CPU_LIMIT:-4}"
PIDS_LIMIT="${PIDS_LIMIT:-256}"
KUBECONFIG_FILE=""
SSH_AGENT_FORWARD=false

while (($#)); do
  case "$1" in
    --memory) (($# >= 2)) || { echo "error: --memory requires a value" >&2; exit 2; }; MEMORY_LIMIT=$2; shift 2;;
    --cpus) (($# >= 2)) || { echo "error: --cpus requires a value" >&2; exit 2; }; CPU_LIMIT=$2; shift 2;;
    --pids-limit) (($# >= 2)) || { echo "error: --pids-limit requires a value" >&2; exit 2; }; PIDS_LIMIT=$2; shift 2;;
    --kubeconfig) (($# >= 2)) && [[ -n "$2" ]] || { echo "error: --kubeconfig requires a file" >&2; exit 2; }; KUBECONFIG_FILE=$2; shift 2;;
    --ssh-agent) SSH_AGENT_FORWARD=true; shift;;
    --host-access) echo "error: --host-access has been removed" >&2; exit 2;;
    *) break;;
  esac
done

[[ "$PIDS_LIMIT" =~ ^[1-9][0-9]*$ ]] || { echo "error: --pids-limit / PIDS_LIMIT must be a positive integer" >&2; exit 2; }
[[ -d "$WORKSPACE" ]] || { echo "Error: workspace path is not an existing directory: $WORKSPACE" >&2; exit 1; }
if [[ -n "$KUBECONFIG_FILE" ]]; then
  [[ -f "$KUBECONFIG_FILE" && -r "$KUBECONFIG_FILE" ]] || { echo "error: kubeconfig must be a readable file: $KUBECONFIG_FILE" >&2; exit 2; }
  KUBECONFIG_FILE="$(cd "$(dirname "$KUBECONFIG_FILE")" && pwd)/$(basename "$KUBECONFIG_FILE")"
  [[ "$KUBECONFIG_FILE" != *:* && "$KUBECONFIG_FILE" != *,* ]] || { echo "error: kubeconfig path must not contain colons or commas" >&2; exit 2; }
fi
if [[ "$SSH_AGENT_FORWARD" == true ]]; then
  [[ -n "${SSH_AUTH_SOCK:-}" && -S "$SSH_AUTH_SOCK" ]] || { echo "error: --ssh-agent requires SSH_AUTH_SOCK to point to an SSH agent socket" >&2; exit 2; }
  SSH_AUTH_SOCK="$(cd "$(dirname "$SSH_AUTH_SOCK")" && pwd)/$(basename "$SSH_AUTH_SOCK")"
  [[ "$SSH_AUTH_SOCK" != *:* && "$SSH_AUTH_SOCK" != *,* ]] || { echo "error: SSH agent socket path must not contain colons or commas" >&2; exit 2; }
  SSH_KNOWN_HOSTS="$HOME/.ssh/known_hosts"
  [[ -f "$SSH_KNOWN_HOSTS" && -r "$SSH_KNOWN_HOSTS" ]] || { echo "error: --ssh-agent requires a readable $SSH_KNOWN_HOSTS file for SSH host verification" >&2; exit 2; }
  SSH_KNOWN_HOSTS="$(cd "$(dirname "$SSH_KNOWN_HOSTS")" && pwd)/$(basename "$SSH_KNOWN_HOSTS")"
  [[ "$SSH_KNOWN_HOSTS" != *:* && "$SSH_KNOWN_HOSTS" != *,* ]] || { echo "error: SSH known_hosts path must not contain colons or commas" >&2; exit 2; }
fi
mkdir -p "$STATE_DIR/state"
chmod 700 "$STATE_DIR" "$STATE_DIR/state"

reject_proxy_credentials() {
  [[ "$1" != *://*@* ]] || { echo "error: proxy URLs with embedded credentials are not supported" >&2; exit 2; }
}

ENV_ARGS=()
for pair in HTTP_PROXY HTTPS_PROXY NO_PROXY; do
  lower="${pair,,}"
  value="${!pair:-${!lower:-}}"
  if [[ -n "$value" ]]; then
    [[ "$pair" == NO_PROXY ]] || reject_proxy_credentials "$value"
    ENV_ARGS+=(--env "$pair=$value" --env "$lower=$value")
  fi
done

GIT_ARGS=()
if [[ -f "$HOME/.gitconfig" ]]; then
  GIT_ARGS+=(-v "$HOME/.gitconfig:/app/.gitconfig:ro,Z")
fi
if [[ -f "$HOME/.config/git/config" ]]; then
  GIT_ARGS+=(-v "$HOME/.config/git/config:/app/.config/git/config:ro,Z")
fi

KUBE_ARGS=()
SSH_ARGS=()
if [[ "$SSH_AGENT_FORWARD" == true ]]; then
  SSH_ARGS+=(-v "$SSH_AUTH_SOCK:/run/ssh-agent.sock" --env SSH_AUTH_SOCK=/run/ssh-agent.sock)
  SSH_ARGS+=(-v "$SSH_KNOWN_HOSTS:/app/.ssh/known_hosts:ro,Z")
fi
if [[ -n "$KUBECONFIG_FILE" ]]; then
  KUBE_ARGS+=(-v "$KUBECONFIG_FILE:/run/kubeconfig:ro,Z")
  ENV_ARGS+=(--env KUBECONFIG=/run/kubeconfig)
fi

USERNS_ARGS=()
if [[ "$ENGINE" == podman ]]; then
  rootless="$($ENGINE info --format '{{.Host.Security.Rootless}}' 2>/dev/null || true)"
  [[ "$rootless" == "true" ]] && USERNS_ARGS+=(--userns=keep-id)
fi

RUN_FLAGS=(-i)
[[ -t 0 ]] && RUN_FLAGS+=(-t)

exec "$ENGINE" run --rm "${RUN_FLAGS[@]}" "${USERNS_ARGS[@]}" \
  --workdir /workspace --read-only --tmpfs /tmp:exec,size=512m,mode=1777 \
  --cap-drop=ALL --security-opt=no-new-privileges \
  --memory="$MEMORY_LIMIT" --cpus="$CPU_LIMIT" --pids-limit="$PIDS_LIMIT" --ulimit core=0 \
  "${ENV_ARGS[@]}" "${GIT_ARGS[@]}" "${KUBE_ARGS[@]}" "${SSH_ARGS[@]}" \
  -v "$STATE_DIR/state:/app/.pi:rw,Z" \
  -v "$WORKSPACE:/workspace:rw,Z" \
  pi-container:latest "$@"
